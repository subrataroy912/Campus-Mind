# CampusMind Frontend Environment Variables
# Copy to .env.local for local development or set in Cloudflare Pages Dashboard -> Settings -> Environment variables

# Backend REST API Base URL
VITE_API_BASE_URL=https://m198-backend.onrender.com

# Maintenance Mode Flag (true / false)
VITE_MAINTENANCE_MODE=false

# CSRF Cookie Name (default: csrf_token)
VITE_CSRF_COOKIE_NAME=csrf_token
