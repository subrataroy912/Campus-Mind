# Optional Vite environment variables for connecting the frontend to a backend.
# The app runs without this file because both values have safe in-code fallbacks.

# REST API base URL. Keep /api when the frontend and backend are served behind the same host.
VITE_API_BASE_URL=/api

# WebSocket/STOMP endpoint. Keep /ws when the frontend and backend are served behind the same host.
VITE_WS_URL=/ws
